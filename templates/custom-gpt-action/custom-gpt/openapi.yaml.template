openapi: 3.1.0
info:
  title: {{displayNameYaml}}
  description: {{descriptionYaml}}
  version: 0.1.0
servers:
  - url: {{actionBaseUrl}}
paths:
  /items/{itemId}:
    get:
      operationId: getItem
      summary: Retrieve one item by identifier
      parameters:
        - name: itemId
          in: path
          required: true
          schema: { type: string }
      responses:
        "200":
          description: Item found
          content:
            application/json:
              schema:
                type: object
                required: [id, name]
                properties:
                  id: { type: string }
                  name: { type: string }
        "404":
          description: Item not found
