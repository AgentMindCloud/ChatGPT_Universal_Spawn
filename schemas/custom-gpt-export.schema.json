{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmindcloud.dev/schemas/chatgpt-spawn/custom-gpt-export-0.1.json",
  "title": "Custom GPT artifact export configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "instructions", "conversationStarters"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "instructions": { "type": "string", "pattern": "^\\./" },
    "conversationStarters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "type": "string", "minLength": 1 }
    },
    "knowledge": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^\\./" }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["openapi", "auth"],
        "properties": {
          "openapi": { "type": "string", "pattern": "^\\./" },
          "auth": { "enum": ["none", "api_key", "oauth"] }
        }
      }
    }
  }
}
